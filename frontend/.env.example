# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site origin (no trailing slash). Used for absolute links.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: Cloudflare Turnstile site key. When set, login/signup/reset show the
# CAPTCHA widget. Enable CAPTCHA in Supabase Auth with the matching secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
